<%- include("includes/head.ejs") %>

<body>
    <h1 style="text-align:center;">Student Records</h1>
    <div class="table-container">
        <form method="get" action="/records/new" class="new-record-form">
            <button class="btn">New Record</button>
        </form>
    
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>USN</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                <% records.forEach(record => { %>
                    <tr>
                        <td><%= record.name %></td>
                        <td><%= record.usn %></td>
                        <td>


                            
                            <form method="post" action="/records/<%=record.id %>">
                              
                                <button class="btn">View Details</button>
                            </form>
                          
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    
</body>
</html>